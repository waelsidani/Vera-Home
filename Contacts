<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verra Home Links</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #fdfdfd;
      text-align: center;
      margin: 0;
      padding: 0;
    }
    .logo {
      margin-top: 30px;
    }
    .logo img {
      max-width: 180px;
      height: auto;
    }
    .links {
      margin-top: 40px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      align-items: center;
    }
    .link-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 80%;
      max-width: 320px;
      padding: 15px;
      background: #008CBA;
      color: white;
      text-decoration: none;
      font-size: 18px;
      font-weight: bold;
      border-radius: 12px;
      transition: 0.3s;
    }
    .link-btn:hover {
      background: #005f73;
    }
    .link-btn img {
      width: 28px;
      height: 28px;
    }
  </style>
</head>
<body>
  <div class="logo">
    <img src="ad07dfc6-6ec7-4cb8-91e8-04ac37011f65.png" alt="Verra Home Logo">
  </div>

  <div class="links">
    <a class="link-btn" href="https://www.facebook.com/share/15yfbBDqUc/" target="_blank">
      <img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook"> Facebook
    </a>

    <a class="link-btn" href="https://www.instagram.com/home_verra/" target="_blank">
      <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram"> Instagram
    </a>

    <a class="link-btn" href="https://www.tiktok.com/@yourtiktokusername" target="_blank">
      <img src="https://cdn-icons-png.flaticon.com/512/3046/3046121.png" alt="TikTok"> TikTok
    </a>

    <a class="link-btn" href="https://wa.me/905059892926" target="_blank">
      <img src="https://cdn-icons-png.flaticon.com/512/733/733585.png" alt="WhatsApp"> WhatsApp (🇹🇷 Turkey)
    </a>

    <a class="link-btn" href="https://wa.me/963992810793" target="_blank">
      <img src="https://cdn-icons-png.flaticon.com/512/733/733585.png" alt="WhatsApp"> WhatsApp (🇸🇾 Syria)
    </a>
  </div>
</body>
</html>
